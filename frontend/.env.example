# Existing Keycloak. Values come from the realm already in use.
# Leave them empty until that client is assigned. Do not invent a host.
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Go API. /api when the SPA is served on the same origin as the API.
VITE_API_BASE=/api

# Local UI preview with sample data. Development server only. Not a login.
# VITE_PREVIEW=1
